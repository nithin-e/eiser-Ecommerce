<%- include('../admin/adminpartials/Header') -%>

<div class="container-xxl position-relative bg-white d-flex p-0">
    <!-- Spinner Start -->
    <div id="spinner" class="show bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center">
        <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
            <span class="sr-only">Loading...</span>
        </div>
    </div>
    <!-- Spinner End -->

    <!-- Sidebar Start -->
    <%- include('../admin/adminpartials/adminSidebar') -%>
    <!-- Sidebar End -->

    <!-- Content Start -->
    <div class="content">
        <!-- Navbar Start -->
        <%- include('../admin/adminpartials/adminNav') -%>
        <!-- Navbar End -->

        <!-- Sale & Revenue Start -->
        <div class="container-fluid pt-4 px-4">
            <div class="row g-4">
                <div class="col-sm-6 col-xl-3">
                    <div class="bg-light rounded d-flex align-items-center justify-content-between p-4">
                        <i class="fa fa-chart-bar fa-3x text-primary"></i>
                        <div class="ms-3">
                            <p class="mb-2" id="totalSaleLabel">Total Sale</p>
                            <h6 class="mb-0" id="totalSaleAmount">₹</h6>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="bg-light rounded d-flex align-items-center justify-content-between p-4">
                        <i class="fa fa-chart-area fa-3x text-primary"></i>
                        <div class="ms-3">
                            <p class="mb-2" id="todayRevenueLabel">Today Revenue</p>
                            <h6 class="mb-0" id="todayRevenueAmount">₹</h6>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="bg-light rounded d-flex align-items-center justify-content-between p-4">
                        <i class="fa fa-chart-pie fa-3x text-primary"></i>
                        <div class="ms-3">
                            <p class="mb-2" id="totalRevenueLabel">Total Revenue</p>
                            <h6 class="mb-0" id="totalRevenueAmount">₹</h6>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="bg-light rounded d-flex align-items-center justify-content-between p-4">
                        <i class="fa fa-chart-line fa-3x text-primary"></i>
                        <div class="ms-3">
                            <button class="mb-2" data-bs-toggle="modal" data-bs-target="#salesReportModal" style="color: #009CFF;">Download Sales Report</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Sale & Revenue End -->

        <!-- Sales Charts Start -->
        <div class="container-fluid pt-4 px-4">
            <div class="row g-4">
                <div class="col-sm-12 col-xl-12">
                    <div class="bg-light text-center rounded p-4" style="height: 550px;">
                        <div class="d-flex align-items-center justify-content-between mb-4">
                            <h6 class="mb-0">Total Sales</h6>
                            <div class="btn-group" role="group" aria-label="Basic example">
                                <button class="btn btn-primary" data-filter="day">Day</button>
                                <button class="btn btn-primary" data-filter="week">Week</button>
                                <button class="btn btn-primary" data-filter="month">Month</button>
                                <button class="btn btn-primary" data-filter="year">Year</button>
                                <button class="btn btn-primary" data-filter="all">All Time</button>
                            </div>

                            <div class="d-flex align-items-center">
                                <div>
                                    <input type="date" class="form-control me-2" id="startDatee" placeholder="Start Date">
                                    <div id="startDateErrorr" class="error-message" style="color: red; font-size: 8px;"></div>
                                </div>
                                <div>
                                    <input type="date" class="form-control me-2" id="endDatee" placeholder="End Date">
                                    <div id="endDateErrorr" class="error-message" style="color: red; font-size: 8px;"></div>
                                </div>
                                <button class="btn btn-primary" id="applyCustomDate">Apply</button>
                            </div>

                        </div>
                        <canvas id="reportsChart" style="height: 300px; display: block; box-sizing: border-box; width: 100%;" width="1375" height="687"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <!-- Sales Charts End -->

        <!-- Recent Sales Start -->
        <div class="container-fluid pt-4 px-4">
            <div class="bg-light text-center rounded p-4">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <h6 class="mb-0">Best selling product</h6>
                    
                </div>
                <div class="table-responsive">
                    <table class="table text-start align-middle table-bordered table-hover mb-0">
                        <thead>
                            <tr class="text-dark">
                                <th scope="col"><input class="form-check-input" type="checkbox"></th>
                                <th scope="col">SlNo</th>
                                <th scope="col">pruduct image</th>
                                <th scope="col">name</th>
                                <th scope="col">quantity</th>
                                <th scope="col">price</th>                       
                            </tr>
                        </thead>
                        <tbody>
                            <% if (OrderInfo && OrderInfo.length > 0) { %>
                                <% OrderInfo.forEach((element, index) => { %>
                                    <tr>
                                        <td><input class="form-check-input" type="checkbox"></td>
                                        <td><%= index + 1 %></td>
                                        <% element.products.forEach(pro => { %>
                                        <td><img src="<%= pro.productImage[0] %>" alt="Product Image" style="width: 50px; height: 50px;"></td>
                                        <td><%= pro.productName %></td>
                                        <td><%= pro.quantity %></td>
                                        <td><%= pro.productPrice %></td>
                                    </tr>
                                    <% }) %>
                                <% }); %>
                            </tbody>
                            <% }else{ %>
                            <p>no produts</p>
                            <% } %>
                        
                    </table>
                </div>
            </div>
        </div>
        <!-- Recent Sales End -->



        <div class="container-fluid pt-4 px-4" style="display: flex;">
            <div class="bg-light text-center rounded p-4" style="width: 50%;">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <h6 class="mb-0">Best selling Category</h6>
                    
                </div>
                <div class="table-responsive">
                    <table class="table text-start align-middle table-bordered table-hover mb-0">
                        <thead>
                            <tr class="text-dark">
                                <th scope="col"><input class="form-check-input" type="checkbox"></th>
                                <th scope="col">SlNo</th>
                                <!-- <th scope="col">Category ID</th> -->
                                <th scope="col">Category Name</th>
                                <th scope="col">Total Sold</th>
                                <th scope="col">Total Revenue</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (topCategories && topCategories.length > 0) { %>                    
                                <% topCategories.forEach((category, index) => { %>
                                    <tr>
                                        <td><input class="form-check-input" type="checkbox"></td>
                                        <td><%= index + 1 %></td>
                                        
                                        <td><%= category.name %></td>
                                        <td><%= category.totalSold %></td>
                                        <td><%= category.totalRevenues %></td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr>
                                    <td colspan="6" class="text-center">No products</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
                
            </div>


            <div class="bg-light text-center rounded p-4" style="width: 50%;">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <h6 class="mb-0">Best selling Brand</h6>
                    
                </div>
                <div class="table-responsive">
                    <table class="table text-start align-middle table-bordered table-hover mb-0">
                        <thead>
                            <tr class="text-dark">
                                <th scope="col"><input class="form-check-input" type="checkbox"></th>
                                <th scope="col">SlNo</th>
                                <th scope="col">Brand Name</th>
                                <th scope="col">Total Sold</th>
                                <th scope="col">Total Revenue</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (topBrands && topBrands.length > 0) { %>                    
                                <% topBrands.forEach((brand, index) => { %>
                                    <tr>
                                        <td><input class="form-check-input" type="checkbox"></td>
                                        <td><%= index + 1 %></td>
                                        <td><%= brand.name %></td>
                                        <td><%= brand.totalSold %></td>
                                        <td><%= brand.totalRevenues %></td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr>
                                    <td colspan="6" class="text-center">No products</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Footer Start -->
        <div class="container-fluid pt-4 px-4">
            <div class="bg-light rounded-top p-4" >
                <div class="row">
                    <div class="col-12 col-sm-6 text-center text-sm-start">
                        &copy; <a href="#">Your Site Name</a>, <h3>eiser</h3>.
                    </div>
                </div>
            </div>
        </div>
        <!-- Footer End -->
    </div>
    
    <!-- Back to Top -->
    <a href="#" class="btn btn-lg btn-primary btn-lg-square back-to-top"><i class="bi bi-arrow-up"></i></a>
</div>

<!-- Sales Report Modal -->
<div class="modal fade" id="salesReportModal" tabindex="-1" aria-labelledby="salesReportModalLabel" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<form id="salesReportForm" action="/salesreport" method="POST">
				<div class="modal-header">
					<h5 class="modal-title" id="salesReportModalLabel">Sales Report</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body">
					<div class="mb-3">
						<label for="startDate" class="form-label">Start Date</label>
						<input type="date" class="form-control" id="startDate" name="startdate" oninput="validateForm()">
						<small id="startDateError" class="text-danger"></small>
					</div>
					<div class="mb-3">
						<label for="endDate" class="form-label">End Date</label>
						<input type="date" class="form-control" id="endDate" name="enddate" oninput="validateForm()">
						<small id="endDateError" class="text-danger"></small>
					</div>
					<div class="mb-3">
						<label for="timeInterval" class="form-label">Time Interval</label>
						<select class="form-select" name="timeInterval" id="timeInterval" oninput="validateForm()">
							<option value="" disabled selected>Options</option>
							<option value="day">Daily</option>
							<option value="week">Weekly</option>
							<option value="month">Monthly</option>
							<option value="year">Yearly</option>
						</select>
					</div>
					<div class="mb-3">
						<label for="downloadFormat" class="form-label">Download Format</label>
						<select class="form-select" id="downloadFormat" name="downloadformat" oninput="validateForm()">
							<option value="" disabled selected>Select Format</option>
							<option value="pdf">PDF</option>
						</select>
						<small id="downloadFormatError" class="text-danger"></small>
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
					<button type="submit" class="btn btn-primary" id="generateReportBtn" disabled>Generate Report</button>
				</div>
			</form>
		</div>
	</div>
</div>




<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
let salesChart;

async function fetchSalesData(period = 'all') {
    console.log('.........................',period);
    
    try {
        const response = await fetch(`/api/sales-data?period=${period}`);
        if (!response.ok) {
            throw new Error(`HTTP error! status: ${response.status}`);
        }
        return await response.json();
    } catch (error) {
        console.error("Could not fetch sales data:", error);
        return [];
    }
}

async function createOrUpdateSalesChart(period = 'all') {
    const salesData = await fetchSalesData(period);

    if (!Array.isArray(salesData) || salesData.length === 0) {
        console.warn('Sales data is empty or not in the expected format:', salesData);
        return;
    }

    updateDynamicLabels(salesData);





    const labels = salesData.map(item => item._id);
    const values = salesData.map(item => item.totalSales);




   

    const ctxLine = document.getElementById('reportsChart').getContext('2d');
    const chartConfig = {
        type: 'line',
        data: {
            labels: labels,
            datasets: [{
                label: 'Sales',
                data: values,
                fill: false,
                borderColor: 'rgb(75, 192, 192)',
                tension: 0.1
            }]
        },
        options: {
            responsive: true,
            scales: {
                y: {
                    beginAtZero: true,
                    title: {
                        display: true,
                        text: 'Total Sales'
                    }
                },
                x: {
                    title: {
                        display: true,
                        text: 'Date'
                    }
                }
            }
        }
    };

    if (salesChart) {
        salesChart.data = chartConfig.data;
        salesChart.update();
    } else {
        salesChart = new Chart(ctxLine, chartConfig);
    }
}

function updateDynamicLabels(salesData) {
    const totalSale = salesData.reduce((sum, item) => sum + item.totalSales, 0);
    document.getElementById('totalSaleLabel').textContent = 'Total Sale';
    document.getElementById('totalSaleAmount').textContent = `₹${totalSale.toFixed(2)}`;

    const todayRevenue = salesData[salesData.length - 1]?.totalSales || 0;
    document.getElementById('todayRevenueLabel').textContent = 'Today Revenue';
    document.getElementById('todayRevenueAmount').textContent = `₹${todayRevenue.toFixed(2)}`;

    const totalRevenue = totalSale;
    document.getElementById('totalRevenueLabel').textContent = 'Total Revenue';
    document.getElementById('totalRevenueAmount').textContent = `₹${totalRevenue.toFixed(2)}`;
}

function updateCharts(period) {
    createOrUpdateSalesChart(period);
}

document.addEventListener('DOMContentLoaded', () => {
    createOrUpdateSalesChart();
});

document.querySelectorAll('[data-filter]').forEach(button => {
    button.addEventListener('click', () => {

    
        
        const period = button.getAttribute('data-filter');
        updateCharts(period)
    });
});
</script>


<script>
document.getElementById('applyCustomDate').addEventListener('click', (event) => {
    event.preventDefault();

    const startDate = document.getElementById('startDatee').value;
    const endDate = document.getElementById('endDatee').value;
    const currentDate = new Date().toISOString().split('T')[0]; 

    const startDateError = document.getElementById('startDateErrorr');
    const endDateError = document.getElementById('endDateErrorr');

    // Clear previous error messages
    startDateError.innerHTML = "";
    endDateError.innerHTML = "";

    let isValid = true;

    if (startDate === "") {
        startDateError.innerHTML = "Start Date is required";
        isValid = false;
    } else if (startDate > currentDate) {
        startDateError.innerHTML = "Start Date must be less than equal to current date";
        isValid = false;
    }

    if (endDate === "") {
        endDateError.innerHTML = "End Date is required";
        isValid = false;
    } else if (endDate > currentDate) {
        endDateError.innerHTML = "End Date must be less than equal to current date";
        isValid = false;
    } else if (endDate < startDate) {
        endDateError.innerHTML = "End Date cannot be less than Start Date";
        isValid = false;
    }

    if (isValid) {
        console.log("Validation passed. Proceeding with date application.");
    }


    const data={
        startDate,
        endDate
    }

    fetch('/coustemChartFliter', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(data) 
})
.then(response => response.json())
.then(data => {
    if(data.success){
        updateDynamicLabelss(data.salesData);
    }
})
.catch(error => {
    console.error('Error:', error);
});

});







