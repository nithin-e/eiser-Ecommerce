<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Category</title>
    <link rel="stylesheet" href="/css/addcategory.css">

    <%-include('../admin/adminpartials/Header')-%>
    
    <!-- navbar start  -->
    <div class="content">
        <%-include('../admin/adminpartials/adminNav')-%>
         <!-- navbar start  -->
     <!-- adminSidebar start -->
     <%-include('../admin/adminpartials/adminSidebar')-%>
     <!-- adminSidebar start -->


     <style>
        .error-message {
            color: red;
            text-align: center;
            margin: 10px 0;
        }
    </style>
    </head>
    <body>
    <div class="form-container" style="margin-left: 250px;margin-top: 80px;">
        <h1>Add Category</h1>
     <% if (locals.exisist) { %>
        <div class="error-message"><%= exisist %></div>
     <% } %>

        <form  action="/storeCatt" method="post" id="categoryForm" >
            <div class="form-group">
                <label for="name">Category Name</label>
                <input type="text" id="name" name="name" required>
                <span style="color: red;" id="error-message"></span>


                <label for="Offerprice">Offer Price (optional (10,20,30 only possible))</label>
            <input type="number" id="Offerprice" name="Offerprice" placeholder="Enter offer price">
            <span class="error-message" id="offer-error"></span>
            </div>
          
            <div class="form-actions">
                <button type="submit">Add Category</button>
            </div>
        </form>
    </div>

    <script>
        document.getElementById("categoryForm").addEventListener("submit", function(event) {
          const nameInput = document.getElementById("name").value.trim();
          const offerPriceInput = document.getElementById("Offerprice").value.trim();
          const errorMessage = document.getElementById("error-message");
          const offerError = document.getElementById("offer-error");
          const specialCharPattern = /[^a-zA-Z\s]/;
          const lowercasePattern = /[a-z]/;
      
          // Clear previous error messages
          errorMessage.innerText = "";
          offerError.innerText = "";
      
          // Validate category name
          if (nameInput === "") {
            event.preventDefault();
            errorMessage.innerText = "Category name is required.";
          } else if (lowercasePattern.test(nameInput)) {
            event.preventDefault();
            errorMessage.innerText = "Category name must be in uppercase.";
          } else if (/\d/.test(nameInput)) {
            event.preventDefault();
            errorMessage.innerText = "Number not allowed in category name.";
          } else if (specialCharPattern.test(nameInput)) {
            event.preventDefault();
            errorMessage.innerText = "Special characters are not allowed in the name.";
          }
      
          // Validate offer price
          const allowedOffers = [10, 20, 30];
          const offerPrice = parseFloat(offerPriceInput);
      
          if (offerPriceInput && !allowedOffers.includes(offerPrice)) {
            event.preventDefault();
            offerError.innerText = "Offer price must be one of the following values: 10, 20, 30.";
          }
        });
      </script>


</body>
</html>
