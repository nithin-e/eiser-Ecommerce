/* Custom select styling */
select {
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    background-color: #ffffff;
    border: 2px solid #e0e0e0;
    border-radius: 25px;
    padding: 12px 45px 12px 20px;
    font-size: 16px;
    color: #333;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    min-width: 200px;
}

/* Custom arrow */
select {
    background-image: 
        linear-gradient(45deg, transparent 50%, #71cd14 50%),
        linear-gradient(135deg, #71cd14 50%, transparent 50%);
    background-position:
        calc(100% - 20px) calc(1em + 2px),
        calc(100% - 15px) calc(1em + 2px);
    background-size:
        5px 5px,
        5px 5px;
    background-repeat: no-repeat;
}

/* Hover and focus states */
select:hover, select:focus {
    border-color: #71cd14;
    box-shadow: 0 4px 8px #71cd14(0, 123, 255, 0.2);
    outline: none;
}

/* Style for options */
select option {
    padding: 12px;
    background-color: #ffffff;
    color: #333;
}

/* Styling for when an option is selected */
select option:checked {
    background-color: #e6f2ff;
    color: #71cd14;
}

/* Custom scrollbar for dropdown (works in some browsers) */
select::-webkit-scrollbar {
    width: 10px;
}

select::-webkit-scrollbar-track {
    background: #f1f1f1;
}

select::-webkit-scrollbar-thumb {
    background: #888;
    border-radius: 5px;
}

select::-webkit-scrollbar-thumb:hover {
    background: #555;
}
/* Base styles for options */
select option {
    padding: 12px 20px;
    background-color: #ffffff;
    color: #333;
    font-size: 16px;
    line-height: 1.5;
    transition: background-color 0.2s ease;
}

/* Hover effect for options */
select option:hover {
    background-color: #f0f8ff;
    cursor: pointer;
}

/* Style for selected option */
select option:checked {
    background-color: #e6f2ff;
    color: #007bff;
    font-weight: bold;
}

/* Custom styles for specific options */
select option[value="?sort=recommended"] {
    border-left: 4px solid #ffd700; /* Gold color for recommended */
}

select option[value="?sort=low_to_high"] {
    border-left: 4px solid #4caf50; /* Green for low to high */
}

select option[value="?sort=high_to_low"] {
    border-left: 4px solid #f44336; /* Red for high to low */
}

/* Enhance readability in dropdown */
select {
    color: #333;
    font-family: Arial, sans-serif;
}

/* Style for disabled options if needed */
select option:disabled {
    color: #999;
    font-style: italic;
}

/* Ensure consistent styling across browsers */
@-moz-document url-prefix() {
    select option {
        padding: 10px 20px;
    }
}
        </style>


        <section class="inspired_product_area section_gap_bottom_custom">
          <div class="container">
            <div class="row">
              <% products.forEach(product => { %>
                <% if (product.status && product.category && product.category.status && product.brand && product.brand.status) { %>
                  <div class="col-lg-3 col-md-4">
                    <div class="single-product">
                      <div class="product-img">
                        <a href="/ViewProduct/<%= product._id %>">
                          <img class="img-fluid w-100" src="<%= product.images[0] %>" alt="" />
                        </a>
                        <% if (product.stockQuantity == 0) { %>
                          <div class="stock-badge" style="color: red;">
                            Out of Stock
                          </div>
                        <% } else if (product.stockQuantity < 10) { %>
                          <div class="stock-badge" style="color: orange;">
                            Limited Stock
                          </div>  
                        <% } else { %>
                          <div class="stock-badge" style="color: green;">
                            In Stock
                          </div> 
                        <% } %>
                      </div>
                      <div class="product-btm" style="text-decoration: none;">
                        <a href="#" class="d-block" style="text-decoration: none;">
                          <h4 style="text-decoration: none;"><%= product.productName %></h4>
                        </a>
                        <div style="display: flex; align-items: center; justify-content: space-between;">
                          <div>
                            <span 
                              style="font-size: 16px; font-weight: 500; color: gray; <% if (product.offerPrice) { %> text-decoration: line-through; text-decoration-color: green;<% } %>" 
                              class="single-price">
                              ₹<%= product.price %>&nbsp;
                            </span>
                          </div>
                          <% if (product.offerPrice) { %>
                            <div style="margin-left: 10px;">
                              <span style="color: green; font-size: 14px; text-decoration: none;" class="offer-price">₹<%= product.offerPrice %></span>
                            </div>
                          <% } else if (product.category.offerPrice == '10%' || product.category.offerPrice  == '20%' ||product.category.offerPrice  == '30%') { %>
                            <span style="color: green; font-size: 14px; text-decoration: none;" class="offer-price">₹<%= product.category.offerPrice  %> Off</span>
                          <% } %>
                          <div style="display: flex; align-items: center;">
                            <% if (cartProductId?.includes(product._id.toString() )) { %>
                              <a id="cartIcon" class="cart-icon" style="text-decoration: none; position: relative;">
                                <i class="fa fa-shopping-cart"    onclick="ExisistCart()"  style="font-size: 1.5rem; color: #71cd14; text-decoration: none; cursor: pointer;"></i>
                                <span style="position: absolute; top: -10px; right: -10px; background-color: red; color: white; border-radius: 50%; padding: 2px 6px; font-size: 0.75rem;">1</span>
                             </a>
                            <% }else{ %>
                              <a id="cartIcon" class="cart-icon" style="text-decoration: none;">
                                <i class="fa fa-shopping-cart" onclick="DirectAddToCart('<%= product._id %>','<%= product.stockQuantity %>')" style="font-size: 1.5rem; color: #71cd14; text-decoration: none; cursor: pointer;"></i>
                              </a>
                            <% } %>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                <% } %>
              <% }) %>
              
             
            </div>
          </div>
        </section>

 




