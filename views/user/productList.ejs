<div class="pagination">
  <% if (pages > 1) { %>
      <ul style="color: 71cd14;">
          <li class="prev-next <%= current === 1 ? 'disabled' : '' %>">
              <a href="?page=<%= current - 1 %>">&laquo;</a>
          </li>
          <% for (let i = 1; i <= pages; i++) { %>
              <% if (i === 1 || i === pages || (i >= current - 1 && i <= current + 1)) { %>
                  <li class="<%= i === current ? 'active' : '' %>">
                      <a href="?page=<%= i %>"><%= i %></a>
                  </li>
              <% } else if (i === current - 2 || i === current + 2) { %>
                  <li class="disabled"><a href="#">...</a></li>
              <% } %>
          <% } %>
          <li class="prev-next <%= current === pages ? 'disabled' : '' %>">
              <a href="?page=<%= current + 1 %>">&raquo;</a>
          </li>
      </ul>
  <% } %>
</div>   
      </div>

    </div>
  </div>
</section>





<script src="https://cdnjs.cloudflare.com/ajax/libs/toastify-js/1.12.0/toastify.min.js"></script>

<script>
  function DirectAddToCart(id,Quantity) {

if(Quantity==0){
  Toastify({
             text: 'Out Of Stock',
              duration: 3000,
              close: true,
              gravity: "top",
              position: "center",
              backgroundColor:' #71cd14',
              className: "toastify-custom",
            }).showToast();
            return
}


    fetch(`/AddToBag/${id}`,{
      method:'GET',
      headers:{'Content-Type': 'application/json'}
    })
    .then(response=>response.json())
    .then(response=>{
      if(response.success){
        console.log(response.msg);

        Toastify({
             text: response.msg,
              duration: 3000,
              close: true,
              gravity: "top",
              position: "center",
              backgroundColor:' #71cd14',
              className: "toastify-custom",
            }).showToast();

            setTimeout(() => {
              location.reload()
            }, 1000);
        
      }
    })
  }



  function ExisistCart() {
    Toastify({
             text: 'this Product Already Exisist In cart',
              duration: 3000,
              close: true,
              gravity: "top",
              position: "center",
              backgroundColor:' #71cd14',
              className: "toastify-custom",
            }).showToast();

            
      }
   
  
</script>
   


  <script>
    function updateMaxPrice() {
      const priceRange = document.getElementById('priceRange');
      const maxPriceInput = document.getElementById('maxPrice');
      maxPriceInput.value = priceRange.value;
      updateLabel(maxPriceInput);
    }
    function updateLabel(input) {
      const label = document.querySelector(`[for="${input.id}"]`);
      label.textContent = `₹ ${input.value}`;
    }
    </script>
   
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@10"></script>
<script>
    function confirmLogout() {
        Swal.fire({
            title: 'Are you sure you want to logout?',
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, logout!',
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = '/logout';
            }
        });
    }
</script>
<script>
  function toggleView(view) {
    if (view === 'listView') {
      document.getElementById('gridViewSection').style.display = 'none';
      document.getElementById('listViewSection').style.display = 'block';
    } else {
