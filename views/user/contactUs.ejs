    <style>
/* Futuristic gradient background */
body {
  background: linear-gradient(45deg, #0f0c29, #302b63, #24243e);
  color: #fff;
  font-family: 'Roboto', sans-serif;
}

.contact {
  padding: 0px 0;
}

/* Glassmorphism effect for containers */
.contact .info-box, .contact .php-email-form {
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10px);
  border-radius: 20px;
  border: 1px solid rgba(255, 255, 255, 0.2);
  box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.37);
  padding: 30px;
  margin-bottom: 30px;
  transition: all 0.3s ease;
}

.contact .info-box:hover {
  transform: scale(1.05);
  box-shadow: 0 12px 48px 0 rgba(31, 38, 135, 0.5);
}

/* Neon text effect */
.contact .info-box h3 {
  font-size: 24px;
  color: #4df7ff;
  text-shadow: 0 0 10px rgba(77, 247, 255, 0.8);
  margin-bottom: 15px;
}

.contact .info-box p {
  color: #e0e0e0;
  font-size: 16px;
  line-height: 1.6;
}

/* Glowing icon effect */
.contact .info-box i {
  font-size: 48px;
  color: #ff00ff;
  text-shadow: 0 0 20px rgba(255, 0, 255, 0.8);
  margin-bottom: 20px;
}

/* Stylish form inputs */
.contact .php-email-form input,
.contact .php-email-form textarea {
  background: rgba(255, 255, 255, 0.05);
  border: none;
  border-bottom: 2px solid #4df7ff;
  color: #fff;
  padding: 15px;
  margin-bottom: 20px;
  transition: all 0.3s ease;
}

.contact .php-email-form input:focus,
.contact .php-email-form textarea:focus {
  background: rgba(255, 255, 255, 0.1);
  box-shadow: 0 0 15px rgba(77, 247, 255, 0.5);
}

/* Animated submit button */
.contact .php-email-form button[type="submit"] {
  background: linear-gradient(45deg, #ff00ff, #00ffff);
  border: none;
  color: #fff;
  padding: 15px 30px;
  font-size: 18px;
  border-radius: 50px;
  cursor: pointer;
  transition: all 0.3s ease;
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0% {
    box-shadow: 0 0 0 0 rgba(255, 0, 255, 0.7);
  }
  70% {
    box-shadow: 0 0 0 20px rgba(255, 0, 255, 0);
  }
  100% {
    box-shadow: 0 0 0 0 rgba(255, 0, 255, 0);
  }
}

.contact .php-email-form button[type="submit"]:hover {
  transform: scale(1.1);
  box-shadow: 0 0 25px rgba(255, 0, 255, 0.8);
}

/* Custom scrollbar */
::-webkit-scrollbar {
  width: 10px;
}

::-webkit-scrollbar-track {
  background: rgba(255, 255, 255, 0.1);
}

::-webkit-scrollbar-thumb {
  background: linear-gradient(45deg, #ff00ff, #00ffff);
  border-radius: 5px;
}

/* Responsive adjustments */
@media (max-width: 768px) {
  .contact .info-box, .contact .php-email-form {
    padding: 20px;
  }
  
  .contact .info-box h3 {
    font-size: 20px;
  }
  
  .contact .info-box i {
    font-size: 36px;
  }
}
    </style>

    
<style>
    h2.contact-heading {
  font-size: 3.5rem;
  text-align: center;
  /* margin-bottom: 50px; */
  position: relative;
  color: transparent;
  background: linear-gradient(45deg, #ff00ff, #00ffff, #ff00ff);
  background-size: 200% 200%;
  background-clip: text;
  -webkit-background-clip: text;
  animation: gradient-animation 5s ease infinite, glow 2s ease-in-out infinite alternate;
  text-transform: uppercase;
  letter-spacing: 5px;
  font-weight: 800;
}

h2.contact-heading::after {
  content: '';
  position: absolute;
  bottom: -10px;
  left: 50%;
  transform: translateX(-50%);
  width: 100px;
  height: 4px;
  background: linear-gradient(90deg, #ff00ff, #00ffff);
  border-radius: 2px;
}

@keyframes gradient-animation {
  0% {
    background-position: 0% 50%;
  }
  50% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0% 50%;
  }
}

@keyframes glow {
  from {
    text-shadow: 0 0 5px #fff, 0 0 10px #fff, 0 0 15px #ff00ff, 0 0 20px #ff00ff;
  }
  to {
    text-shadow: 0 0 10px #fff, 0 0 20px #fff, 0 0 30px #00ffff, 0 0 40px #00ffff;
  }
}
</style>





