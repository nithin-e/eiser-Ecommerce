  <script>
  function DirectAddToCart(id,Quantity) {

if(Quantity==0){
  Toastify({
             text: 'Out Of Stock',
              duration: 3000,
              close: true,
              gravity: "top",
              position: "center",
              backgroundColor:' #71cd14',
              className: "toastify-custom",
            }).showToast();
            return
}


    fetch(`/AddToBag/${id}`,{
      method:'GET',
      headers:{'Content-Type': 'application/json'}
    })
    .then(response=>response.json())
    .then(response=>{
      if(response.success){
        console.log(response.msg);

        Toastify({
             text: response.msg,
              duration: 3000,
              close: true,
              gravity: "top",
              position: "center",
              backgroundColor:' #71cd14',
              className: "toastify-custom",
            }).showToast();

            setTimeout(() => {
              location.reload()
            }, 1000);
        
      }
    })
  }



  function ExisistCart() {
    Toastify({
             text: 'this Product Already Exisist In cart',
              duration: 3000,
              close: true,
              gravity: "top",
              position: "center",
              backgroundColor:' #71cd14',
              className: "toastify-custom",
            }).showToast();

            
      }
   
  
</script>


  
